# ==============================================================================
# ENTORNO DE BASE DE DATOS (DOCKER / POSTGRESQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=vet_saas_db
POSTGRES_PORT=5432

# ==============================================================================
# CONEXIÓN PRISMA ORM (MULTI-SCHEMA)
# ==============================================================================
# URL de conexión al schema compartido 'public'.
# Para operaciones sobre schemas de tenants, la conexión o search_path se resuelve en runtime.
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/vet_saas_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/vet_saas_db"

# ==============================================================================
# APLICACIÓN NEXT.JS & RESOLUCIÓN MULTITENANT
# ==============================================================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dominio raíz para la resolución de subdominios de tenants (ej: vet1.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN
# ==============================================================================
# Clave para JWT / NextAuth / Iron-Session
AUTH_SECRET="secret_token_cambiar_por_cadena_aleatoria_segura_de_64_caracteres"

